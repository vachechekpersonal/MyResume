@page "/"
@using System.Text.Json
@implements IDisposable
@inject ICvSource CvSource

<PageTitle>@(_cv?.Profile.Name ?? "CV")</PageTitle>

@if (_error is not null)
{
    <p class="status status--error" role="alert">@_error</p>
}
else if (_cv is null)
{
    <p class="status" aria-busy="true">Loading CV…</p>
}
else
{
    <Header Profile="_cv.Profile">
        <Actions>
            <PrintButton />
            <ThemeToggle />
        </Actions>
    </Header>
    <main>
        <ProfileSection Profile="_cv.Profile" />
        <SkillsSection Groups="_cv.SkillGroups" />
        <TimelineSection Experiences="_cv.Experiences" />
        <EducationSection Qualifications="_cv.Qualifications" />
        <LanguagesSection Languages="_cv.Languages" />
    </main>
    <Footer Profile="_cv.Profile" />
}

@code {
    private readonly CancellationTokenSource _loading = new();
    private Cv? _cv;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _cv = await CvSource.LoadAsync(_loading.Token);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or InvalidOperationException)
        {
            _error = "The CV data could not be loaded. Please refresh the page to try again.";
        }
        catch (OperationCanceledException)
        {
            // The page was disposed while loading; nothing to show.
        }
    }

    public void Dispose()
    {
        _loading.Cancel();
        _loading.Dispose();
    }
}
