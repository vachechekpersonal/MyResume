@inject IJSRuntime Js

<button type="button" class="icon-button" aria-label="Download as PDF" title="Download as PDF (opens the print dialogue)" @onclick="PrintAsync">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="M7 10l5 5 5-5" /><path d="M5 21h14" /></svg>
</button>

@code {
    private Task PrintAsync() => Js.InvokeVoidAsync("window.print").AsTask();
}
