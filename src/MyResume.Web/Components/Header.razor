<header class="site-header">
    <div>
        <h1>@Profile.Name</h1>
        <p class="site-header__subtitle">@Profile.Title <span aria-hidden="true">·</span> @Profile.Location</p>
    </div>
    <div class="site-header__actions no-print">
        @Actions
    </div>
</header>

@code {
    [Parameter, EditorRequired] public Profile Profile { get; set; } = default!;
    [Parameter] public RenderFragment? Actions { get; set; }
}
