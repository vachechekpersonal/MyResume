@implements IDisposable
@inject ThemeService Theme

<button type="button" class="icon-button" aria-label="@Label" title="@Label" @onclick="Theme.ToggleAsync">
    @if (Theme.Current == Themes.Dark)
    {
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
    }
    else
    {
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" /></svg>
    }
</button>

@code {
    private string Label => Theme.Current == Themes.Dark ? "Switch to light theme" : "Switch to dark theme";

    protected override void OnInitialized() => Theme.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !Theme.IsInitialised)
        {
            await Theme.InitialiseAsync();
        }
    }

    public void Dispose() => Theme.Changed -= OnThemeChanged;

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);
}
