@* Presentational: the parent owns selection state and passes it down. *@
<button type="button"
        class="chip @(Selected ? "chip--selected" : null)"
        aria-pressed="@(Selected ? "true" : "false")"
        @onclick="OnToggle">
    @Skill
</button>

@code {
    [Parameter, EditorRequired] public string Skill { get; set; } = string.Empty;
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
